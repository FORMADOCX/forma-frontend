# Backend origin only, WITHOUT /api/v1. Set in Vercel project environment variables.
# FORMA_API_URL=http://127.0.0.1:8000
# Production: internal server-to-server origin (may be private; never exposed to browser)
# FORMA_API_URL=http://django:8000
# Public browser-accessible HTTPS Django origin, WITHOUT /api/v1, required in production for previews and downloads
# NEXT_PUBLIC_API_URL=https://api.your-verified-backend-domain.tld
# For local Django, set NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Optional public site origin (only after domain approval):
# NEXT_PUBLIC_SITE_URL=https://yourdomain.tld
# Leave false until editorial launch, verified sitemaps and localization review.
FORMA_ENABLE_INDEXING=false

# Copy to .env.local and edit the values for your own Django environment.
# Base origins only: do not append /api/v1 or include credentials.
# Server-side Django API origin (not exposed as a NEXT_PUBLIC_* variable).
FORMA_API_URL=http://127.0.0.1:8000

# Browser-accessible Django API origin. Production must be public HTTPS.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional. Set only after approval of an HTTPS frontend domain.
# NEXT_PUBLIC_SITE_URL=https://www.example.org

# Reserved launch flag. The current source forces indexing off regardless.
FORMA_ENABLE_INDEXING=false

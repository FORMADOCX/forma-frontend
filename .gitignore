
# ============================================================
# FORMA Frontend — .gitignore
# Next.js + TypeScript + JetBrains IntelliJ IDEA + Vercel
# ============================================================

# Dependencies
/node_modules/
/.pnp
.pnp.*
.yarn/*
!/.yarn/patches
!/.yarn/plugins
!/.yarn/releases
!/.yarn/sdks
!/.yarn/versions

# Next.js build output
/.next/
/out/

# Other build output
/build/
/dist/
/coverage/

# Turbopack
/.turbo/

# Vercel
/.vercel/

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.*.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# JetBrains IntelliJ IDEA / WebStorm
.idea/
*.iml
*.ipr
*.iws
out/

# VS Code local settings
.vscode/*
!.vscode/extensions.json

# Operating system
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~
.cache/
.tmp/
temp/

# Local test artifacts
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Local archives and backups
*.bak
*.backup
*.orig
*.rej

# Debug
*.pid
*.pid.lock

# Local deployment output
.vercel_build_output/
